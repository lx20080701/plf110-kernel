# ============================================================
#  PLF110 (OnePlus ACE 5 Racing / MT6989 / Android 16 / 6.1.134)
#  功能开关：改完 push，重新跑 workflow 即可
#  true = 开启，false = 关闭
# ============================================================

# ---- 网络 ----
BBR=true          # BBR 拥塞控制（出包后 sysctl -w net.ipv4.tcp_congestion_control=bbr 启用）
BBRV3=false       # BBRv3 补丁（更激进，默认关）
NETSCHED=true     # FQ / CAKE / PIE / FQ_PIE 网络调度器（游戏/热点延迟）
IPSET=true        # IP_SET + IPv6 NAT（Droidspaces NAT66、容器内 UFW/Fail2Ban）
TTL=false         # TTL / Hop-Limit target（热点共享防检测，用得上再开）

# ---- 充电 ----
SDP900=true       # USB SDP 充电电流 500mA -> 900mA

# ---- 容器 / 文件系统 ----
NTSYNC=true       # NTSync（容器里跑 Wine / Windows 游戏）
NTFS3=true        # NTFS3 读写挂载（内置）
SQUASHFS=true     # squashfs 只读镜像（Droidspaces 镜像）
UNICODE=false     # Unicode 修复补丁与本机型 unicode 表冲突（OPLUS 改过），保持 false

# ---- 进阶（可选）----
PERF_TWEAKS=true  # WildKernels 优化补丁集（22 个：内存/IO/调度/网络小优化，已在同机型验证）
EXTRA_FS=true     # ISO9660 + UDF（挂 ISO 镜像）+ CIFS/SMB（挂 NAS/Windows 共享）+ NFS
CONTAINER_NET=true # IPVLAN（容器 ipvlan 网络）+ XT_TARGET_CHECKSUM（部分共享/VPN 校验和修复）
NET_DEFAULTS=true # 默认拥塞控制 = bbr、默认 qdisc = fq（不用再 sysctl）

# ---- 构建 ----
DEBUG_INFO=false  # true = 保留 KASAN/BTF/调试信息（很慢，仅供调试）
