# ============================================================
#  PLF110 (OnePlus ACE 5 Racing / MT6989 / Android 16 / 6.1.134)
#  功能开关：改完 push，重新跑 workflow 即可
#  true = 开启，false = 关闭
#
#  【本轮策略：run12 — 第一批最小容器集 + 第二批增强】
#   第一批（run11 已验证）：DROIDSPACES 让 Droidspaces 容器跑起来。
#   第二批：NTsync（Wine / Windows 程序）、容器 CPU/PID 限额、
#           IPv6 NAT、user-ns 提权漏洞修复。
#   第二批补丁全部 vendored 在 patches/ds_*.patch，
#   来源 Goldzxcbug/Droidspaces_Kernel_patch @dc0f76b
#   （补上该仓库表格里尚未覆盖的 PLF110 / MT6989 / 16.0.3.500 这一版本）。
#   注意：关闭 ≠ 删除。prepare.sh 仍会写 "# CONFIG_XXX is not set" 占位。
# ============================================================

# ---- 容器运行必需 ----
DROIDSPACES=true    # namespaces / cgroups / SYSVIPC / POSIX_MQUEUE / DEVTMPFS
                    # / OVERLAY_FS / netfilter + MACVLAN 等

# ---- 第二批增强（补丁来源见文件头）----
NTSYNC=true         # NT 同步原语 drivers/misc/ntsync（Wine / Windows 程序）
                    # 补丁：patches/ds_ntsync_base.patch + ds_ntsync_compat_android14-6.1.patch
CGROUP_LIMITS=true  # 容器 CPU / PID 限额（CGROUP_PIDS + CFS_BANDWIDTH）
                    # 补丁：patches/ds_cgroup_limits_6.1.patch（KMI 兼容版，保住原厂模块 ABI）
USERNS_CVE=true     # CVE-2026-43499 user-ns rtmutex 提权修复
                    # 补丁：patches/ds_cve_userns_rtmutex_6.1.patch
IP_SET_NAT=true     # ipset + IPv6 NAT（Droidspaces check 里唯一缺的网络项）

# ---- 以下全部关闭（占位保留，不删除）----
BBR=false           # TCP BBR 拥塞控制（CONFIG_TCP_CONG_BBR）
BBRV3=false         # BBRv3 补丁（源码补丁，无 config 符号）
NET_SCHED=false     # FQ / CAKE / PIE / FQ_PIE 网络调度器
TTL_TARGET=false    # TTL / Hop-Limit target 补丁
SDP_CHARGE=false    # USB SDP 充电 500mA -> 900mA（源码补丁，无 config 符号）
NTFS3=false         # NTFS3 读写挂载（CONFIG_NTFS3_FS）
SQUASHFS=false      # squashfs 只读镜像（CONFIG_SQUASHFS）
UNICODE_FIX=false   # Unicode 修复补丁（源码补丁；且与本机型 unicode 表冲突）

# ---- 以前的其它功能，本次同样关闭 ----
PERF_TWEAKS=false   # WildKernels 优化补丁集
EXTRA_FS=false      # ISO9660 / UDF / CIFS / NFS
CONTAINER_NET=false # IPVLAN / XT_TARGET_CHECKSUM（MACVLAN 由 DROIDSPACES 提供）
NET_DEFAULTS=false  # 默认拥塞控制 / 默认 qdisc

# ---- 构建（本次不动）----
KABI_BYPASS=true    # 跳过 vendor 模块 CRC 校验（原厂源码未公开，ABI 已用 BTF 证明一致；不要关）

# ---- LTO 由 workflow 的 lto 输入控制（none / thin），本次不动 ----
